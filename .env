APP_NAME=TiendaComics
APP_ENV=local
APP_KEY=base64:N5svRpdp7MOqwjaOdTrUDAlmUShcuEUkEogrVbZSHRI=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Conexión a FastAPI
FASTAPI_URL=http://localhost:8000
FASTAPI_TIMEOUT=30
FASTAPI_VERIFY_SSL=false

# Conexión a MySQL (usando la misma DB que FastAPI)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tienda_comics_final
DB_USERNAME=root
#Contraseña de la base de datos
DB_PASSWORD=

# Configuración de sesión (importante para mantener auth)
# SESSION_DRIVER=database volver a quitar
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_TABLE=sessions

# Cache y colas
CACHE_DRIVER=file
QUEUE_CONNECTION=sync

# Mail (configuración básica para desarrollo)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@tiendacomics.com"
MAIL_FROM_NAME="${APP_NAME}"

# Variables adicionales para frontend
VITE_APP_NAME="${APP_NAME}"
VITE_FASTAPI_URL="${FASTAPI_URL}"
